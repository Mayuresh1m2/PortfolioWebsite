---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const postURL = new URL(`/blog/${post.id}/`, Astro.site).toString();
const blogPostingSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.data.title,
	description: post.data.description,
	datePublished: post.data.pubDate.toISOString(),
	url: postURL,
	mainEntityOfPage: postURL,
	author: {
		'@type': 'Person',
		name: 'Mayuresh Srivastava',
		url: Astro.site?.toString(),
	},
};
---

<Layout title={post.data.title} description={post.data.description}>
	<script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />

	<article>
		<header class="post-header">
			<h1>{post.data.title}</h1>
			<p class="meta">
				<time datetime={post.data.pubDate.toISOString()}>
					{
						post.data.pubDate.toLocaleDateString('en-US', {
							year: 'numeric',
							month: 'long',
							day: 'numeric',
						})
					}
				</time>
				{
					post.data.tags.length > 0 && (
						<span class="tags">
							{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
						</span>
					)
				}
			</p>
		</header>
		<div class="content">
			<Content />
		</div>
	</article>
	<p class="back"><a href="/blog">&larr; Back to all posts</a></p>
</Layout>

<style>
	.post-header {
		margin-bottom: 2rem;
	}

	.post-header h1 {
		margin-bottom: 0.4rem;
	}

	.meta {
		color: var(--color-text-muted);
		font-size: 0.9rem;
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		align-items: center;
	}

	.tags {
		display: flex;
		gap: 0.5rem;
	}

	.tag {
		background: var(--color-bg-raised);
		border-radius: 999px;
		padding: 0.15rem 0.6rem;
		font-size: 0.8rem;
	}

	.content :global(h2) {
		margin-top: 2rem;
	}

	.back {
		margin-top: 3rem;
	}
</style>
